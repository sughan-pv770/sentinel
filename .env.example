# Copy to gateway/.env for local (non-docker) runs. All are optional --
# sensible defaults are baked into app/config.py.

# Leave unset to use the in-memory state store (zero external services).
# Set this to run against real Redis, e.g. redis://localhost:6379/0
SENTINELX_REDIS_URL=

# Where the origin microservice SentinelX protects is reachable.
SENTINELX_ORIGIN_BASE_URL=http://localhost:9000

SENTINELX_ENVIRONMENT=development
