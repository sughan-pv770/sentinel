# ─── Core ────────────────────────────────────────────────────────────────────
SENTINELX_ENVIRONMENT=development
SENTINELX_REDIS_URL=                    # Leave empty to use in-memory store
SENTINELX_ORIGIN_BASE_URL=http://localhost:9000

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SENTINELX_JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
SENTINELX_JWT_REFRESH_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_REFRESH
SENTINELX_JWT_EXPIRE_MINUTES=60
SENTINELX_JWT_REFRESH_EXPIRE_HOURS=168

# ─── MFA ──────────────────────────────────────────────────────────────────────
SENTINELX_MFA_TOTP_ISSUER=SentinelX
SENTINELX_MFA_OTP_TTL_SECONDS=300
SENTINELX_MFA_MAX_ATTEMPTS=5
SENTINELX_MFA_DEVICE_TRUST_DAYS=30
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SENTINELX_MFA_ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION_32BYTE_KEY_==

# ─── Rate Limiting ────────────────────────────────────────────────────────────
SENTINELX_RATE_LIMIT_ENABLED=true
SENTINELX_RATE_LIMIT_WINDOW_SECONDS=60
SENTINELX_RATE_LIMIT_BURST_CEILING=500
SENTINELX_RATE_LIMIT_STEP_UP_THRESHOLD=30

# ─── ML Engine ────────────────────────────────────────────────────────────────
SENTINELX_ML_INFERENCE_TIMEOUT_MS=50
SENTINELX_ML_CIRCUIT_BREAKER_THRESHOLD=5
SENTINELX_ML_CIRCUIT_BREAKER_RECOVERY_S=30
SENTINELX_ML_SHADOW_MODE=false

# ─── Observability ────────────────────────────────────────────────────────────
SENTINELX_METRICS_ENABLED=true
SENTINELX_OTEL_ENABLED=false
SENTINELX_OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://jaeger:4317

# ─── SSE ──────────────────────────────────────────────────────────────────────
SENTINELX_SSE_PING_INTERVAL_SECONDS=30
